PORT=5000
NODE_ENV=development
# Local:  mongodb://127.0.0.1:27017/clienthub
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clienthub
MONGODB_URI=mongodb://127.0.0.1:27017/clienthub
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Origin of the React app (used for CORS with credentials)
CLIENT_URL=http://localhost:5173
